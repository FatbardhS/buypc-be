PORT=3000
CORS_ORIGIN=http://localhost:4200
# Comma-separated emails that become admin when they register or log in
ADMIN_EMAILS=you@example.com
# Confirmation emails go out from this Gmail account (a Google app password, not the normal password).
# Leave empty to only log the links.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Website address used in email links
APP_URL=http://localhost:4200
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgres://buypc:buypc@localhost:5432/buypc
